{
  "title": "Audiogram roughness does not establish incremental systolic-pressure prediction across two NHANES cycles",
  "abstract": "Among 3,690 source and 4,141 target complete-case adults, bilateral audiogram roughness did not establish added systolic blood pressure prediction over demographics, BMI, medication status and standard audiometric summaries: target augmented-minus-baseline MSE 0.182868 mmHg squared, joint PSU-bootstrap 95% interval [-0.481723, 1.193913]. This is exploratory cross-cycle transfer, not equivalence or independent-site validation.",
  "keywords": [
    "audiometry",
    "systolic blood pressure",
    "NHANES",
    "roughness",
    "cross-cycle prediction",
    "negative result"
  ],
